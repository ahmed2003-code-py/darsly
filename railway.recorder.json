{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.recorder",
    "watchPatterns": ["**"]
  },
  "deploy": {
    "startCommand": "node dist/main.js",
    "preDeployCommand": ["sh scripts/wait-for-schema.sh"],
    "drainingSeconds": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
