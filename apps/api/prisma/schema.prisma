// Darsly — full data model (ERD).
// Multi-tenancy: a "tenant" is a TeacherProfile. Every teacher-owned row carries
// tenantId and every query in the API is scoped through TenantGuard + Prisma filters.
// Money: all amounts are integer piasters (1 EGP = 100 piasters) to avoid float drift.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Identity & Auth ───────────────────────────────

enum Role {
  SUPER_ADMIN
  TEACHER
  STUDENT
  // A non-learning, non-teaching account whose authority comes entirely from
  // AcademyMembership (a Center Admin who does not teach). No TeacherProfile,
  // no StudentProfile, no tenantId.
  STAFF
}

model User {
  id           String    @id @default(cuid())
  role         Role
  // Egyptian E.164, e.g. +2010xxxxxxxx. Optional secondary contact.
  phone        String?   @unique
  // Primary login handle for everyone (students, teachers, admins).
  email        String?   @unique
  // Optional handle a person can sign in with instead of their email or phone.
  // Lowercase, starts with a letter, so it can never be mistaken for a number.
  username     String?   @unique
  passwordHash String?
  fullName     String
  avatarUrl    String?
  locale       String    @default("ar")
  isActive     Boolean   @default(true)
  /// Phase 7: SUPER_ADMIN's own Admin Studio theme choice ({themeId,
  /// customTokens?}). Null = platform default. Nobody else reads or writes
  /// this — scoped to the caller's own id everywhere it's touched, and it
  /// never influences Student/Teacher/Academy rendering.
  adminThemePreference Json?
  // Brute-force defense: consecutive failures soft-lock the account.
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  teacherProfile TeacherProfile?
  studentProfile StudentProfile?
  sessions       DeviceSession[]
  notifications  Notification[]
  auditLogs      AuditLog[]           @relation("actor")
  sentMessages   ChatMessage[]
  resetTokens    PasswordResetToken[]
  activationTokens AcademyActivationToken[]

  // Academy workspace model (v2). A user's authority lives on memberships, not
  // on the global role. Additive — existing tenantId relations are untouched.
  ownedAcademies     Academy[]           @relation("academyOwner")
  academyMemberships AcademyMembership[]
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt          DateTime?
  liveAttendance     LiveAttendance[]
  liveMessages       LiveChatMessage[]
  groupAssignments   GroupAssignment[]
  taughtSessions     GroupSession[]
}

// ─────────────────────────── Academy (Workspace) ───────────────────────────
// The Academy is the first-class tenant/aggregate root (SaaS workspace model).
// Migration is identity-preserving: each Academy.id == the old TeacherProfile.id,
// so every existing tenantId value is already a valid academyId (no FK moves).

enum AcademyStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

// Classification only — never a security boundary (that stays academyId +
// membership + capability). PERSONAL is a teacher's own auto-provisioned
// workspace (id == TeacherProfile.id); CENTER is an organisation created by a
// platform admin. Existing rows are PERSONAL and are never converted in bulk.
enum AcademyKind {
  PERSONAL
  CENTER
}

enum AcademyRole {
  OWNER
  TEACHER
  ASSISTANT
  STUDENT
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  LEFT
}

// Additive platform service fee (never a deduction from the teacher).
enum FeeType {
  PERCENT
  FIXED
}

// SaaS Evolution Phase 5 — governs the free-course self-enroll path only.
// AUTOMATIC (default): today's behavior, unchanged — instant ACTIVE.
// MANUAL: a free-course request becomes PENDING_APPROVAL; staff approve/reject.
// DEMO: same as MANUAL for self-enroll, plus staff may demoEnroll() any
// student into any course (free or paid) with zero financial effect.
enum AcademyEnrollmentMode {
  AUTOMATIC
  MANUAL
  DEMO
}

model Academy {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  status      AcademyStatus @default(ACTIVE)
  kind        AcademyKind   @default(PERSONAL)
  ownerUserId String
  owner       User          @relation("academyOwner", fields: [ownerUserId], references: [id])

  // Branding (inline for now; normalizable later without a domain change).
  logoUrl      String?
  coverUrl     String?
  // The design system the academy published, promoted to its brand identity.
  // colorPrimary/colorAccent stay the canonical two-colour brand; this carries
  // the rest (background, ink, surface, radius, density…) so the console and any
  // future surface can dress themselves in the look the teacher actually chose,
  // instead of every academy sharing one platform palette.
  brandTokens  Json?
  colorPrimary String  @default("#4A32C9")
  colorAccent  String  @default("#4A32C9")
  tagline      String  @default("")

  // Settings (moved off TeacherProfile at migration time).
  language              String @default("ar")
  currency              String @default("EGP")
  maxConcurrentSessions Int    @default(2)

  // Revenue: additive platform service fee the STUDENT pays on top of the price.
  feeType  FeeType @default(PERCENT)
  feeValue Int     @default(20) // percent when PERCENT, fixed piasters when FIXED

  // SaaS Evolution Phase 5. Governs ONLY the free-course self-enroll path
  // (EnrollmentsService.enroll) — a paid course's activation is unaffected by
  // this in every mode: payment verification is already the human-gated step,
  // and duplicating that gate here would mean two places deciding when money
  // is confirmed. See EnrollmentsService for the exact per-mode behavior.
  enrollmentMode AcademyEnrollmentMode @default(AUTOMATIC)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete

  memberships   AcademyMembership[]
  domains       AcademyDomain[]
  featureFlags  AcademyFeatureFlag[]
  groups        Group[]
  rooms         Room[]
  groupSessions GroupSession[]

  // Academy Studio (AI site) — Phase 1. All additive.
  siteFacts AcademyProfileFacts?
  site      AcademySite?
  media     AcademyMedia[]
  aiJobs    AiJob[]
  claims    AcademyClaim[]

  activationTokens AcademyActivationToken[]
  invitationLinks  AcademyInvitationLink[]

  @@index([status])
  @@index([kind, status])
}

// Per-academy feature toggles. A missing row means "default for that key" (see
// FeatureFlagsService.DEFAULT_ENABLED / FEATURE_FLAG_KEYS), not "off" — so
// shipping a new flag never requires backfilling every academy. Platform-admin
// managed only.
model AcademyFeatureFlag {
  id        String   @id @default(cuid())
  academyId String
  academy   Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  key       String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  updatedBy String? // userId of the platform admin who last changed it

  @@unique([academyId, key])
  @@index([academyId])
}

// Custom / subdomain hosts that resolve to this academy (verified only).
model AcademyDomain {
  id         String    @id @default(cuid())
  academyId  String
  academy    Academy   @relation(fields: [academyId], references: [id], onDelete: Cascade)
  hostname   String    @unique
  verifiedAt DateTime?
  isPrimary  Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([academyId])
}

// A (User, Academy, Role) relationship. All in-academy authority is per-membership.
model AcademyMembership {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  academyId   String
  academy     Academy          @relation(fields: [academyId], references: [id], onDelete: Cascade)
  role        AcademyRole
  status      MembershipStatus @default(ACTIVE)
  // A student's single primary academy; one true per user. Enforced in application code
  // AND at the DB level via a partial unique index (migration 20260920040600 — not
  // representable here since Prisma's DSL has no WHERE-qualified @@unique).
  isHome      Boolean          @default(false)
  // Optional named-capability overrides layered on top of the role defaults.
  permissions Json             @default("[]")
  invitedBy   String?
  joinedAt    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt   DateTime?

  @@unique([userId, academyId])
  @@index([academyId, role, status])
  @@index([userId, isHome])
}

enum GroupStatus {
  ACTIVE
  ARCHIVED
}

// A class/cohort within one academy. Distinct from per-course Enrollment —
// a group is how an academy organizes its students operationally (who's
// taught together, who attendance is taken for), not what they're enrolled in.
model Group {
  id          String      @id @default(cuid())
  academyId   String
  academy     Academy     @relation(fields: [academyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      GroupStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt   DateTime?

  members            GroupMembership[]
  assignments        GroupAssignment[]
  attendanceSessions AttendanceSession[]
  groupSessions      GroupSession[]

  @@index([academyId, status])
}

// A student's membership in a group. A student may belong to multiple groups.
// academyId is denormalized (same convention as Enrollment.tenantId) so
// tenant-scoped queries and isolation checks never need to join through Group.
model GroupMembership {
  id        String         @id @default(cuid())
  groupId   String
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academyId String
  addedAt   DateTime       @default(now())
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt DateTime?

  @@unique([groupId, studentId])
  @@index([academyId])
  @@index([studentId])
}

enum GroupAssignmentRole {
  TEACHER
  ASSISTANT
}

// A staff member's assignment to a group — the resource-level scope on top of
// the academy-wide `group.manage`/`attendance.mark` capabilities: a TEACHER or
// ASSISTANT may act on a group only if assigned to it (OWNER acts academy-wide
// regardless). See AcademyOpsAccessService.
model GroupAssignment {
  id        String              @id @default(cuid())
  groupId   String
  group     Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      GroupAssignmentRole
  academyId String
  createdAt DateTime            @default(now())
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt DateTime?

  @@unique([groupId, userId])
  @@index([academyId])
  @@index([userId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// One attendance-taking occasion for a group, on one calendar date. The
// (groupId, date) uniqueness is what actually prevents a duplicate session for
// the same group/day — AttendanceRecord's own uniqueness then follows from it.
model AttendanceSession {
  id        String    @id @default(cuid())
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  academyId String
  date      DateTime  @db.Date
  createdBy String
  createdAt DateTime  @default(now())
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt DateTime?

  records AttendanceRecord[]

  @@unique([groupId, date])
  @@index([academyId])
}

model AttendanceRecord {
  id        String            @id @default(cuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    AttendanceStatus
  academyId String
  markedBy  String
  markedAt  DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt DateTime?

  @@unique([sessionId, studentId])
  @@index([academyId])
  @@index([studentId])
}

enum RoomStatus {
  ACTIVE
  ARCHIVED
}

// A physical academy room — distinct from LiveSession's Daily.co video room
// (roomName/roomUrl there), which is a meeting-provider artifact, not a place.
// OWNER-managed only (see permissions.ts: room.manage is not granted to
// TEACHER/ASSISTANT by default).
model Room {
  id        String     @id @default(cuid())
  academyId String
  academy   Academy    @relation(fields: [academyId], references: [id], onDelete: Cascade)
  name      String
  location  String?
  capacity  Int?
  status    RoomStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt DateTime?

  sessions GroupSession[]

  @@index([academyId, status])
}

enum GroupSessionStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

// A scheduled occurrence for a Group — a physical/in-person class slot, never
// the online video classroom (LiveSession, unaffected and untouched here).
// Overlap protection is two-layered: an app-level pre-check for a friendly
// structured error, and a DB-level EXCLUDE constraint (migration
// 20260920_academy_scheduling — GiST, not representable in Prisma's schema
// DSL) that is the actual race-condition guarantee for concurrent requests.
model GroupSession {
  id            String             @id @default(cuid())
  academyId     String
  academy       Academy            @relation(fields: [academyId], references: [id], onDelete: Cascade)
  groupId       String
  group         Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // The staff member running this occurrence. Nullable — a session can be
  // scheduled before a teacher is assigned — but teacher-overlap protection
  // only applies once one is set, and it is checked across the WHOLE
  // platform (a person cannot teach two academies at the same instant
  // either), not just within this academy.
  teacherUserId String?
  teacher       User?              @relation(fields: [teacherUserId], references: [id])
  roomId        String?
  room          Room?              @relation(fields: [roomId], references: [id])
  startAt       DateTime
  endAt         DateTime
  status        GroupSessionStatus @default(SCHEDULED)
  createdBy     String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt     DateTime?

  @@index([academyId, startAt])
  @@index([groupId, startAt])
  @@index([roomId, startAt])
  @@index([teacherUserId, startAt])
}

// Single-use, hashed password-reset tokens (forgot-password flow).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // sha256(userId + ":" + code). Binding the user into the hash is what lets a
  // short 6-digit code stay unique across the table — two people can hold the
  // code 123456 at the same time without colliding.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  // Wrong guesses against this code. A 6-digit code is only as strong as the
  // number of tries allowed, so the count is enforced, not just observed.
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

// One-time Center Admin activation. The raw token lives only in the emailed
// link; only sha256(token) is stored. Consumed atomically (usedAt) so a replay
// cannot activate twice, and bound to both the user and the academy it was
// issued for so it can never be redeemed for anyone else.
model AcademyActivationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  academyId String
  academy   Academy   @relation(fields: [academyId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
  @@index([academyId])
}

// A single-use, expiring, revocable staff invitation for one Center + one role.
// The raw token exists only in the generated URL; only sha256(token) is
// stored. Redemption reads academyId/role from this row alone — never from
// the client — and OWNER/STUDENT are never valid values here.
model AcademyInvitationLink {
  id              String    @id @default(cuid())
  academyId       String
  academy         Academy   @relation(fields: [academyId], references: [id], onDelete: Cascade)
  role            AcademyRole
  tokenHash       String    @unique
  createdByUserId String
  expiresAt       DateTime
  usedAt          DateTime?
  usedByUserId    String?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([academyId, usedAt])
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, expiresAt])
}

// One row per logged-in device. Refresh tokens are bound to a session so we can
// enforce MAX concurrent devices and kill exactly one device on kick/revoke.
model DeviceSession {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash  String
  deviceName        String?
  deviceFingerprint String?
  ip                String?
  userAgent         String?
  createdAt         DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  revokedAt         DateTime?
  revokedReason     String?

  playbackSessions PlaybackSession[]

  @@index([userId, revokedAt])
}

// ─────────────────────────── Tenants & Profiles ────────────────────────────

enum TeacherStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model TeacherProfile {
  id     String @id @default(cuid()) // == tenantId everywhere
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  slug                   String           @unique
  bio                    String           @default("")
  /// Everything this teacher teaches. A set rather than one subject, because a
  /// maths teacher usually takes both school systems — "الرياضيات" for the
  /// national one and "Math" for the language schools — and being asked to pick
  /// one of them hid them from half the students they actually teach.
  subjects               TeacherSubject[]
  /// The bands this teacher teaches, chosen when they sign up. Every course
  /// they create is offered to some subset of these and never outside them.
  stages                 EducationStage[]
  introVideoUrl          String?
  /// Whether this academy is reachable by message at all. Turning it off closes
  /// the conversation in both directions: the student cannot write, the teacher
  /// cannot either, and neither of them is shown a chat that goes nowhere.
  acceptsStudentMessages Boolean          @default(true)
  // Language of instruction ("ar" | "en") — a discovery filter.
  language               String           @default("ar")
  status                 TeacherStatus    @default(PENDING)
  verifiedAt             DateTime?
  // Platform cut, percent 0–100; set per-teacher by super admin.
  commissionPercent      Int              @default(20)
  // Teacher-Security defaults applied to their students
  maxConcurrentSessions  Int              @default(2)
  settings               Json             @default("{}")
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  grades         TeacherGrade[]
  courses        Course[]
  coupons        Coupon[]
  payoutMethods  PayoutMethodSaved[]
  payoutRequests PayoutRequest[]
  securityEvents SecurityEvent[]
  announcements  Announcement[]
  liveSessions   LiveSession[]
  reviews        Review[]
  chatThreads    ChatThread[]
  challenges     Challenge[]
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt      DateTime?
}

model StudentProfile {
  id      String        @id @default(cuid())
  userId  String        @unique
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  gradeId String?
  grade   GradeLevel?   @relation(fields: [gradeId], references: [id])
  /// Which school system this student is in — GENERAL or LANGUAGES, never BOTH
  /// (that value describes a subject, not a student). Null for anyone who
  /// signed up before the question existed: like an unset year, it means the
  /// filter has nothing to go on, so they are shown everything rather than
  /// locked out of the platform they already paid for.
  track   SubjectTrack?

  // Motivation / streaks
  currentStreak     Int       @default(0)
  longestStreak     Int       @default(0)
  lastActivityDate  DateTime?
  weeklyGoalLessons Int       @default(5)

  interests         StudentInterest[]
  enrollments       Enrollment[]
  progress          LessonProgress[]
  notes             VideoNote[]
  bookmarks         VideoBookmark[]
  quizAttempts      QuizAttempt[]
  questionReports   QuestionReport[]
  challengeAttempts ChallengeAttempt[]
  submissions       AssignmentSubmission[]
  reviews           Review[]
  certificates      Certificate[]
  payments          Payment[]
  playbackSessions  PlaybackSession[]
  securityEvents    SecurityEvent[]
  chatThreads       ChatThread[]
  liveBookings      LiveBooking[]
  savedCourses      SavedCourse[]
  walletTxns        WalletTransaction[]
  walletTopups      WalletTopup[]

  // Gamification (additive — a student without a row is simply at zero).
  gamification    StudentGamification?
  gamificationLog GamificationEvent[]
  achievements    StudentAchievement[]
  titles          StudentTitle[]
  missions        StudentMission[]
  leaderboard     LeaderboardEntry[]
  redemptions     RewardRedemption[]
  cosmetics       StudentCosmetic[]
  customization   StudentCustomization?

  groupMemberships  GroupMembership[]
  attendanceRecords AttendanceRecord[]

  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt DateTime?
}

// A student's saved / wishlisted course.
model SavedCourse {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([studentId, courseId])
  @@index([studentId])
}

// ─────────────────────────── Catalog taxonomy ──────────────────────────────

/// Which school system a subject belongs to.
///
/// Egypt runs two in parallel and they are not the same course: a language
/// school's "Math" is taught in English against a different syllabus than the
/// national system's "الرياضيات", and a student in one has no use for a teacher
/// of the other. So they are separate subjects rather than one subject with two
/// names — which is also how a teacher describes what they do.
///
/// `BOTH` is for the subjects every student sits whichever school they are in:
/// Arabic, religion, social studies, second languages. Those are one row, not
/// two, because there is only one of them in the world.
enum SubjectTrack {
  GENERAL
  LANGUAGES
  BOTH
}

model Subject {
  id        String       @id @default(cuid())
  /// Stable key for the platform's own catalogue, so seeding it again updates
  /// the rows teachers and courses already point at instead of duplicating them.
  code      String?      @unique
  nameAr    String
  nameEn    String
  icon      String?
  sortOrder Int          @default(0)
  isActive  Boolean      @default(true)
  /// Defaults to BOTH so a subject that predates this field, or one an admin
  /// adds without thinking about systems, is shown to everybody rather than
  /// disappearing from half the platform.
  track     SubjectTrack @default(BOTH)

  teachers   TeacherSubject[]
  courses    Course[]
  interests  StudentInterest[]
  challenges Challenge[]
}

/// What a teacher teaches. Many-to-many: see `TeacherProfile.subjects`.
model TeacherSubject {
  tenantId  String
  subjectId String
  teacher   TeacherProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([tenantId, subjectId])
  @@index([subjectId])
}

/// The bands a teacher teaches and a course targets.
///
/// Coarser than `GradeLevel` on purpose: a teacher signs up saying "I teach
/// secondary", not "I teach secondary years one, two and three", and a course
/// is offered to a band rather than to a single year. A student still picks
/// their own year, and `GradeLevel.stage` is what joins the two.
enum EducationStage {
  PRIMARY
  PREPARATORY
  SECONDARY
  /// Egypt's new upper-secondary track, which runs alongside the old one.
  BACCALAUREATE
}

model GradeLevel {
  id        String          @id @default(cuid())
  nameAr    String
  nameEn    String
  // e.g. "secondary-3" (الصف الثالث الثانوي)
  code      String          @unique
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  /// Which band this year belongs to, so a course offered to a stage reaches
  /// every student sitting in one of its years.
  stage     EducationStage?

  students   StudentProfile[]
  courses    CourseGrade[]
  teachers   TeacherGrade[]
  challenges Challenge[]
}

/// Which years a course is offered to.
model CourseGrade {
  courseId String
  gradeId  String
  course   Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  grade    GradeLevel @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@id([courseId, gradeId])
  @@index([gradeId])
}

model TeacherGrade {
  tenantId String
  gradeId  String
  teacher  TeacherProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  grade    GradeLevel     @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@id([tenantId, gradeId])
}

model StudentInterest {
  studentId String
  subjectId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([studentId, subjectId])
}

// ─────────────────────────── Courses & Content ─────────────────────────────

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CoursePricingModel {
  ONE_TIME
  MONTHLY_SUBSCRIPTION
  BUNDLE
}

/// What a course's exam is for.
///
/// Both are one named QUIZ lesson; they differ only in what failing costs you.
/// A FINAL exam sits at the end and locks nothing — the student reaches it by
/// working through the course, and passing it is what completes the course
/// (and so earns the certificate, which already requires every lesson). A GATE
/// exam is a placement test: until it is passed the course is shut except for
/// the exam, its remedial lesson, and the free previews.
enum CourseExamMode {
  GATE
  FINAL
}

model Course {
  id       String         @id @default(cuid())
  tenantId String
  teacher  TeacherProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title         String
  description   String  @default("")
  thumbnailUrl  String?
  /// A short clip the teacher records to sell the course. It is marketing, not
  /// a lesson: stored as a plain public MP4 like the cover image, so a visitor
  /// who is not logged in can watch it. Lesson video goes through the
  /// encrypted-HLS pipeline instead and never through here.
  introVideoUrl String?

  /// The one exam for this course, and the one assignment.
  ///
  /// A lesson is still what holds them — access, completion, points and
  /// certificates are all keyed on a lesson — but the course names which lesson
  /// is *the* exam. Being one column rather than a list is what makes it one
  /// per course instead of one per lesson.
  ///
  /// Naming an exam also gates the course: until a student passes it, the only
  /// things they can open are the exam itself and whatever it sends them to
  /// watch. A course that names none behaves exactly as it always did.
  examLessonId       String?        @unique
  examLesson         Lesson?        @relation("courseExam", fields: [examLessonId], references: [id], onDelete: SetNull)
  /// What the exam is for. A teacher writing their first course usually means a
  /// final test of what was studied, not a door to get in — so FINAL is the
  /// default and GATE is the deliberate choice.
  examMode           CourseExamMode @default(FINAL)
  assignmentLessonId String?        @unique
  assignmentLesson   Lesson?        @relation("courseAssignment", fields: [assignmentLessonId], references: [id], onDelete: SetNull)
  /// The AcademyMedia row behind introVideoUrl, kept so replacing or removing
  /// the clip can delete the stored object instead of orphaning it.
  introVideoMediaId  String?
  subjectId          String?
  subject            Subject?       @relation(fields: [subjectId], references: [id])
  /// The exact years this course is for. A teacher picks from the years inside
  /// the stages they teach, so "second baccalaureate" reaches those students
  /// and nobody else — a listing full of courses for other years is the thing
  /// this replaces. Empty means every year they teach: never narrowed, which
  /// is not the same as for nobody.
  grades             CourseGrade[]

  status       CourseStatus       @default(DRAFT)
  pricingModel CoursePricingModel @default(ONE_TIME)
  // piasters; for MONTHLY_SUBSCRIPTION this is the monthly price
  priceCents   Int                @default(0)
  currency     String             @default("EGP")

  // Access rules (Teacher-Security suite B)
  // lesson access expires N days after unlock; null = never
  accessWindowDays Int?
  // max plays per lesson per student; null = unlimited
  defaultViewsCap  Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt DateTime?

  units         CourseUnit[]
  enrollments   Enrollment[]
  coupons       Coupon[]
  reviews       Review[]
  certificates  Certificate[]
  payments      Payment[]
  bundleParents BundleItem[]  @relation("bundleChild")
  bundleItems   BundleItem[]  @relation("bundleParent")
  savedBy       SavedCourse[]
  challenges    Challenge[]

  @@index([tenantId, status])
  @@index([subjectId, status])
}

// A BUNDLE-priced course contains other courses.
model BundleItem {
  bundleId String
  courseId String
  bundle   Course @relation("bundleParent", fields: [bundleId], references: [id], onDelete: Cascade)
  course   Course @relation("bundleChild", fields: [courseId], references: [id], onDelete: Cascade)

  @@id([bundleId, courseId])
}

model CourseUnit {
  id        String  @id @default(cuid())
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  sortOrder Int     @default(0)
  // The one unit a course may have for lessons added with no section at all —
  // never rendered as a section itself, just a flat list above the named ones.
  isDefault Boolean @default(false)

  lessons   Lesson[]
  // Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt DateTime?

  @@index([courseId, sortOrder])
}

enum LessonType {
  VIDEO
  QUIZ
  ASSIGNMENT
}

model Lesson {
  id                 String     @id @default(cuid())
  unitId             String
  unit               CourseUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  /// Back-references for the three roles a lesson can be given by name.
  examOfCourse       Course?    @relation("courseExam")
  assignmentOfCourse Course?    @relation("courseAssignment")
  remedialForQuizzes Quiz[]     @relation("quizRemedial")
  title              String
  // What the lesson covers, shown to the student above the player.
  description        String?
  type               LessonType @default(VIDEO)
  sortOrder          Int        @default(0)

  videoAssetId String?     @unique
  videoAsset   VideoAsset? @relation(fields: [videoAssetId], references: [id])
  durationSec  Int         @default(0)

  isFreePreview       Boolean   @default(false)
  // Content drip: unlock at a fixed date, or N days after enrollment (first match wins)
  dripUnlockAt        DateTime?
  dripAfterEnrollDays Int?
  // Per-lesson overrides of course access rules
  viewsCap            Int?
  accessWindowDays    Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt DateTime?

  attachments      Attachment[]
  progress         LessonProgress[]
  notes            VideoNote[]
  bookmarks        VideoBookmark[]
  quiz             Quiz?
  assignment       Assignment?
  playbackSessions PlaybackSession[]
  chatMessages     ChatMessage[]

  @@index([unitId, sortOrder])
}

enum VideoAssetStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

// A processed video: original is transcoded to AES-128 encrypted HLS renditions.
// Raw MP4 storage keys are NEVER exposed through the API.
model VideoAsset {
  id              String           @id @default(cuid())
  tenantId        String
  originalKey     String // storage key of the uploaded source (private)
  hlsMasterKey    String? // storage key of the encrypted HLS master playlist
  encryptionKeyId String? // points at HlsEncryptionKey
  status          VideoAssetStatus @default(UPLOADING)
  durationSec     Int              @default(0)
  sizeBytes       BigInt           @default(0)
  renditions      Json             @default("[]") // [{height, bandwidth, playlistKey}]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  lesson Lesson?
}

// AES-128 keys for HLS segments; rotated per HLS_KEY_ROTATION_SECONDS.
// Keys are only ever served to an authorized, watermarked playback session.
model HlsEncryptionKey {
  id        String    @id @default(cuid())
  keyHex    String
  createdAt DateTime  @default(now())
  rotatedAt DateTime?
}

model Attachment {
  id           String    @id @default(cuid())
  lessonId     String
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  fileName     String
  storageKey   String
  mimeType     String
  sizeBytes    Int       @default(0)
  downloadable Boolean   @default(true)
  // Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt    DateTime?
}

// ─────────────────────────── Enrollment & Progress ─────────────────────────

enum EnrollmentStatus {
  /// A payment has been submitted and is waiting to be confirmed. This is the
  /// platform checking that money arrived — not a teacher deciding whether to
  /// let someone in. Never used for the free-course approval wait below —
  /// those are two different kinds of "pending" and must not share a status.
  PENDING_PAYMENT
  /// Phase 5: a free-course request under an academy's MANUAL/DEMO
  /// enrollmentMode, waiting on staff sign-off. Never reached by a paid
  /// course — see EnrollmentsService for why.
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  EXPIRED
  REVOKED
}

/// Phase 5: distinguishes how an ACTIVE/REJECTED enrollment got there, for
/// rows created through the two new staff-driven paths. Null means "the
/// existing checkout/free-enroll path" — every row that predates this column,
/// and every AUTOMATIC-mode row created after it, is null.
enum EnrollmentSource {
  MANUAL_APPROVAL
  DEMO
}

model Enrollment {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tenantId  String // denormalized for tenant-scoped queries

  /// No default: access is granted by a code path that decided to grant it,
  /// never by a row that forgot to say. There is no waiting room any more —
  /// a free course enrols on the spot and a paid one on a confirmed payment.
  status        EnrollmentStatus
  approvedAt    DateTime?
  // subscription/window end; null = lifetime
  expiresAt     DateTime?
  revokedReason String?
  /// Phase 5: set only by EnrollmentsService.approve()/demoEnroll(). Null
  /// everywhere else — see EnrollmentSource.
  source        EnrollmentSource?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  /// The student took this off their own shelf. It only ever applies to an
  /// enrolment that is already dead — revoked, rejected or expired — and it
  /// hides nothing from the teacher, the payments or the books: the row is the
  /// record that money changed hands, so it is never deleted. Reads filter on
  /// status as well, which is what makes re-enrolling put the course back
  /// without any code path having to remember to clear this.
  hiddenAt DateTime?

  payments  Payment[]
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt DateTime?

  @@unique([studentId, courseId])
  @@index([tenantId, status])
}

model LessonProgress {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  lastPositionSec Int       @default(0)
  watchedPct      Int       @default(0)
  /// Content-seconds this student has actually consumed of this lesson,
  /// accumulated across every session. Progress is cumulative; a single
  /// session's elapsed time is not, which is why completion used to be
  /// unreachable for anyone who resumed or scrubbed.
  watchedSec      Int       @default(0)
  viewCount       Int       @default(0)
  completedAt     DateTime?
  // when this student's lesson access window opened (for accessWindowDays)
  firstUnlockedAt DateTime?
  updatedAt       DateTime  @updatedAt

  @@unique([studentId, lessonId])
}

model VideoNote {
  id           String         @id @default(cuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  timestampSec Int
  body         String
  createdAt    DateTime       @default(now())
  // Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt    DateTime?

  @@index([studentId, lessonId])
}

model VideoBookmark {
  id           String         @id @default(cuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  timestampSec Int
  label        String         @default("")
  createdAt    DateTime       @default(now())

  @@index([studentId, lessonId])
}

// ─────────────────────────── Security suite ────────────────────────────────

// One row per player open. watermarkId is the forensic key: it is burned into
// the roving overlay and steganographic token; leak-trace resolves it back here.
model PlaybackSession {
  id              String         @id @default(cuid())
  watermarkId     String         @unique // e.g. DRS-89421-A8X9
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId        String
  lesson          Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  tenantId        String
  deviceSessionId String?
  deviceSession   DeviceSession? @relation(fields: [deviceSessionId], references: [id])

  ip         String?
  userAgent  String?
  country    String?
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  /// The previous heartbeat, so each one can credit only the real time and the
  /// real position advance since the last — which is what stops a seek to the
  /// end from counting as having watched it.
  lastBeatAt DateTime?
  lastPosSec Int       @default(0)
  // compacted playback telemetry: [{t, type: play|pause|seek|hb, pos}]
  events     Json      @default("[]")

  @@index([tenantId, startedAt])
  @@index([studentId, lessonId])
}

enum SecurityEventType {
  MULTI_IP_PLAYBACK
  SESSION_LIMIT_KICK
  DEVTOOLS_DETECTED
  RAPID_SEEK_ANOMALY
  VIEW_CAP_EXCEEDED
  LEAK_TRACED
  MANUAL_FLAG
}

enum SecurityEventSeverity {
  INFO
  WARNING
  CRITICAL
}

model SecurityEvent {
  id         String                @id @default(cuid())
  type       SecurityEventType
  severity   SecurityEventSeverity @default(WARNING)
  tenantId   String?
  tenant     TeacherProfile?       @relation(fields: [tenantId], references: [id])
  studentId  String?
  student    StudentProfile?       @relation(fields: [studentId], references: [id])
  meta       Json                  @default("{}")
  createdAt  DateTime              @default(now())
  resolvedAt DateTime?
  resolvedBy String?

  @@index([tenantId, resolvedAt, createdAt])
}

// ─────────────────────────── Payments & Ledger ─────────────────────────────

enum PaymentStatus {
  PENDING // submitted with proof, awaiting manual verification
  PAID // verified
  REJECTED // proof rejected by teacher/admin
  FAILED
  REFUNDED
}

// How the student transferred the money (manual, proof-based flow).
enum PaymentMethod {
  INSTAPAY
  VODAFONE_CASH
  BANK_TRANSFER
  OTHER
  // Paid out of the student's own prepaid balance. No transfer happens: the
  // money already entered the platform when the wallet was topped up, so
  // settlement debits the student's wallet rather than platform cash.
  WALLET
}

model Payment {
  id           String         @id @default(cuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id])
  courseId     String
  course       Course         @relation(fields: [courseId], references: [id])
  enrollmentId String?
  enrollment   Enrollment?    @relation(fields: [enrollmentId], references: [id])
  tenantId     String

  // amountCents is the TOTAL the student paid. In the additive-fee model that is
  // netCents (academy earning) + feeCents (platform service fee). Nullable for
  // legacy rows recorded under the old commission model.
  amountCents Int
  feeCents    Int? // platform service fee portion of amountCents
  netCents    Int? // academy's earning portion of amountCents
  // How much of amountCents was covered by the student's wallet balance, applied
  // automatically at submit time — the rest (amountCents - walletCents) is what
  // an actual transfer must cover, and what the matching engine looks for. Zero
  // for a course paid entirely by transfer; equal to amountCents for `method:
  // WALLET` (paid entirely from the balance, no transfer at all).
  walletCents Int           @default(0)
  currency    String        @default("EGP")
  status      PaymentStatus @default(PENDING)
  gateway     String        @default("manual") // manual proof-based; paymob/fawry/stripe later

  // Manual proof-of-payment flow
  method         PaymentMethod?
  proofImageUrl  String? // client-resized screenshot (data URL)
  reference      String? // transaction/reference id or sender number
  /// What the uploaded receipt says — see WalletTopup.proofReading.
  proofReading   Json?
  rejectedReason String?
  verifiedById   String? // user id of the teacher/admin who verified

  gatewayRef String?
  couponId   String?
  coupon     Coupon?   @relation(fields: [couponId], references: [id])
  paidAt     DateTime?
  // Separation of duties: a manual self-verification (teacher/owner) sets status
  // PAID + paidAt (student gets access) but leaves settledAt null — the earning is
  // NOT credited to the withdrawable ledger yet. An independent settlement (admin,
  // or a matched real payment-event) sets settledAt and books the ledger credit.
  settledAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  ledgerTransaction LedgerTransaction?
  invoice           Invoice?
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt         DateTime?

  @@index([tenantId, status, createdAt])
  @@index([studentId, status])
}

enum PaymentEventStatus {
  MATCHED // auto-matched a pending payment and verified it
  UNMATCHED // no candidate — needs manual review
  AMBIGUOUS // several candidates — needs manual disambiguation
  DUPLICATE // a prior event already handled this transfer
}

// A raw incoming-transfer event reported by the Android notification listener
// running on the receiving wallet's phone. The backend matches it to a pending
// payment (amount + reference + time window) and auto-verifies.
model PaymentEvent {
  id               String             @id @default(cuid())
  provider         PaymentMethod
  amountCents      Int
  reference        String?
  occurredAt       DateTime
  rawMessage       String             @default("")
  /// The name of the person who sent the money, as the provider printed it.
  ///
  /// The one piece of evidence on a transfer a student cannot read off somebody
  /// else's receipt — the amount and the reference are both on a screenshot
  /// they could have been forwarded, and the name is whoever actually holds the
  /// wallet. Kept so a match can be justified after the fact, and so an admin
  /// looking at a queue can see who paid without reading the raw SMS.
  payerName        String?
  deviceId         String?
  status           PaymentEventStatus @default(UNMATCHED)
  matchedPaymentId String?
  // A transfer can settle a course payment OR a wallet top-up — the two live in
  // different tables, so which one this event credited needs its own column to
  // stay traceable. Exactly one of the two is ever set.
  matchedTopupId   String?
  note             String? // why unmatched/ambiguous, or manual-match actor
  // Stable transfer identity (provider + normalized reference + amount). A replayed
  // notification collides on this unique key and is rejected as a DUPLICATE rather
  // than matching a second, unrelated payment. Null when no reference was supplied —
  // in which case the event is NEVER auto-verified (manual review only).
  dedupeKey        String?            @unique
  createdAt        DateTime           @default(now())
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt        DateTime?

  @@index([status, createdAt])
  @@index([provider, amountCents, occurredAt])
}

// Admin-configured accounts students transfer money to. Money is central to the
// platform; each teacher's share is tracked in the ledger and withdrawn via payouts.
model PlatformPaymentAccount {
  id           String        @id @default(cuid())
  method       PaymentMethod
  label        String // e.g. "إنستاباي درسلي"
  handle       String // phone / IPA / IBAN
  instructions String        @default("")
  isActive     Boolean       @default(true)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// Double-entry ledger: every financial fact is a balanced transaction.
// Entries are immutable — corrections are new ADJUSTMENT transactions.
model LedgerTransaction {
  id          String         @id @default(cuid())
  description String
  paymentId   String?        @unique
  payment     Payment?       @relation(fields: [paymentId], references: [id])
  payoutId    String?        @unique
  payout      PayoutRequest? @relation(fields: [payoutId], references: [id])
  createdAt   DateTime       @default(now())

  entries   LedgerEntry[]
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt DateTime?
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

// Account naming convention:
//   platform:cash            — money held by the platform
//   platform:commission      — platform earnings
//   teacher:<tenantId>:balance — a teacher's withdrawable balance
model LedgerEntry {
  id            String            @id @default(cuid())
  transactionId String
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])
  account       String
  direction     LedgerDirection
  amountCents   Int // always positive; direction carries the sign
  tenantId      String?
  createdAt     DateTime          @default(now())
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt     DateTime?

  @@index([account])
  @@index([tenantId])
}

// ─────────────────────────── Student wallet ────────────────────────────────
// A student's prepaid balance is a platform-global liability: one balance the
// student spends across any academy. Like a teacher's balance, the authoritative
// number is DERIVED from the ledger (account `student:<studentId>:wallet`), never
// stored — so it can never drift. WalletTransaction below is a human-readable
// mirror for the "my wallet" history screen, not the source of truth.
enum WalletTxnKind {
  TOPUP // funds in — a matched transfer (reuses the payment listener), card, or admin credit
  PURCHASE // funds out — bought a course/lesson from the balance
  REFUND // funds back in — a reversed purchase
  ADJUST // manual correction by an admin
}

model WalletTransaction {
  id          String         @id @default(cuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  kind        WalletTxnKind
  // Signed in the student's favour: TOPUP/REFUND positive, PURCHASE negative.
  amountCents Int
  description String
  // Provenance links (all optional): the payment that funded a top-up, or the
  // course/lesson a purchase unlocked. The ledger transaction carries the balanced
  // double-entry; this row is the label the student reads.
  paymentId   String?
  courseId    String?
  lessonId    String?
  ledgerTxnId String?
  createdAt   DateTime       @default(now())
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt   DateTime?

  @@index([studentId, createdAt])
}

enum WalletTopupStatus {
  PENDING // student submitted a transfer proof, awaiting confirmation
  APPROVED // confirmed → wallet credited
  REJECTED // proof rejected
}

// A student's request to add funds to their wallet by transfer. Kept separate
// from Payment (which is course-bound) so the wallet top-up never needs a course.
// On APPROVED the ledger is credited and a WalletTransaction(TOPUP) is written.
// The proof-based approval mirrors manual course payments; a later increment can
// auto-approve from a matched listener transfer.
model WalletTopup {
  id             String            @id @default(cuid())
  studentId      String
  student        StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amountCents    Int
  currency       String            @default("EGP")
  method         PaymentMethod
  proofImageUrl  String
  reference      String?
  /// What the uploaded receipt says, as read from the image — the amount, the
  /// time it was sent, and who it was sent to. Evidence, never proof: the bank's
  /// SMS is what says money arrived; this says whose it is. See proof-check.ts.
  proofReading   Json?
  status         WalletTopupStatus @default(PENDING)
  rejectedReason String?
  reviewedById   String? // admin user id who approved/rejected
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt      DateTime?

  @@index([status, createdAt])
  @@index([studentId, createdAt])
}

model Coupon {
  id       String         @id @default(cuid())
  tenantId String
  teacher  TeacherProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courseId String?
  course   Course?        @relation(fields: [courseId], references: [id])

  code           String
  percentOff     Int? // 1–100
  amountOffCents Int?
  maxUses        Int?
  usedCount      Int       @default(0)
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  // Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt      DateTime?

  payments Payment[]

  @@unique([tenantId, code])
}

enum PayoutMethod {
  BANK_TRANSFER
  VODAFONE_CASH
  INSTAPAY
}

model PayoutMethodSaved {
  id        String         @id @default(cuid())
  tenantId  String
  teacher   TeacherProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  method    PayoutMethod
  // masked display + full details, e.g. {iban, bankName} or {walletPhone}
  details   Json
  isDefault Boolean        @default(false)
  createdAt DateTime       @default(now())
  // Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt DateTime?
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

model PayoutRequest {
  id       String         @id @default(cuid())
  tenantId String
  teacher  TeacherProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  amountCents Int
  currency    String       @default("EGP")
  method      PayoutMethod
  destination Json // snapshot of the payout method details at request time
  status      PayoutStatus @default(REQUESTED)
  adminNote   String?
  processedBy String?
  processedAt DateTime?
  createdAt   DateTime     @default(now())

  ledgerTransaction LedgerTransaction?
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt         DateTime?

  @@index([status, createdAt])
}

model Invoice {
  id        String    @id @default(cuid())
  paymentId String    @unique
  payment   Payment   @relation(fields: [paymentId], references: [id])
  serial    String    @unique // e.g. DRS-INV-2026-000042
  pdfKey    String? // storage key of the rendered RTL PDF
  createdAt DateTime  @default(now())
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt DateTime?
}

// ─────────────────────────── Assessment ────────────────────────────────────

model Quiz {
  id               String  @id @default(cuid())
  lessonId         String  @unique
  lesson           Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  /// What to watch when the exam says you are not ready yet.
  ///
  /// A lesson in the same course rather than a bare URL, so it plays through
  /// the same protected pipeline as everything else and needs no second upload
  /// path. Failing opens it; it is the one thing besides the exam that a
  /// student who has not passed can reach.
  remedialLessonId String?
  remedialLesson   Lesson? @relation("quizRemedial", fields: [remedialLessonId], references: [id], onDelete: SetNull)
  passingScore     Int     @default(50) // percent
  /// How long the student gets, in seconds, from opening the paper to sending
  /// it. Enforced on the server against the attempt's own `startedAt`: a
  /// countdown the client draws is a courtesy, not the rule.
  timeLimitSec     Int?
  shuffleQuestions Boolean @default(false)
  maxAttempts      Int? // null = unlimited; caps how many times a student may submit
  /// Mark the written answers against the teacher's model answer instead of
  /// queueing them for the teacher to read.
  ///
  /// Off unless the teacher asks for it, and it never marks an answer wrong on
  /// its own account: anything it cannot judge — the feature disabled, a
  /// missing model answer, a provider that failed — goes to the teacher exactly
  /// as it did before.
  aiGrading        Boolean @default(false)
  /// How close to the model answer counts as right, as a percentage. Binary by
  /// design: at or above this the question is full marks, below it is zero, and
  /// the teacher can still regrade either way.
  aiThresholdPct   Int     @default(60)
  /// Whether a student gets to see the right answers once they are done with
  /// the paper.
  ///
  /// On by default, which is what the platform already did. A teacher who reuses
  /// the same paper across intakes turns it off, and their students see their
  /// score and their own answers without the key.
  ///
  /// It never overrides the anti-replay rule: answers appear only once the
  /// student can no longer sit the paper again, because handing someone the key
  /// and a spare attempt is the same as handing them the marks.
  showAnswers      Boolean @default(true)

  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER // manually graded
}

model QuizQuestion {
  id               String           @id @default(cuid())
  quizId           String
  quiz             Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type             QuestionType     @default(MCQ)
  prompt           String
  options          Json             @default("[]") // [{id, text}]
  /// Kept in step with the first entry of `correctOptionIds`, so code that has
  /// not been deployed yet still grades a single-answer question correctly.
  /// Everything reads the array.
  correctOptionId  String?
  /// Every option that counts as right. One for most questions; a question can
  /// ask for more, and then the student has to name all of them.
  correctOptionIds String[]         @default([])
  /// How many the student may pick. The teacher sets it, because "choose two"
  /// is a different question from "choose the one that is true" even when the
  /// options are identical.
  maxSelections    Int              @default(1)
  /// What a good answer looks like, for the questions a machine cannot mark.
  /// The teacher reads it while grading instead of recalling it, and it is what
  /// the student is shown afterwards.
  modelAnswer      String           @default("")
  explanation      String           @default("")
  points           Int              @default(1)
  sortOrder        Int              @default(0)
  reports          QuestionReport[]
}

/// A student saying "this question is wrong".
///
/// A key typed in by hand is a key that is sometimes typed in wrong, and the
/// people who find out are the students who answered correctly and were marked
/// down for it. Until now they had nowhere to say so: the only route was a
/// message to the teacher, if that teacher accepted messages, and nothing tied
/// the complaint to the question it was about.
///
/// One report per student per question — a student is registering a doubt, not
/// voting, and letting them file ten does not make the question more wrong.
model QuestionReport {
  id         String               @id @default(cuid())
  questionId String
  question   QuizQuestion         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentId  String
  student    StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// The attempt they were looking at, for the teacher reading the complaint.
  attemptId  String?
  note       String               @default("")
  status     QuestionReportStatus @default(OPEN)
  resolvedAt DateTime?
  /// The teacher's user id, so "who decided this" survives.
  resolvedBy String?
  createdAt  DateTime             @default(now())

  @@unique([questionId, studentId])
  @@index([status, createdAt])
}

enum QuestionReportStatus {
  OPEN
  /// The teacher agreed: the key was changed and the paper re-marked.
  ACCEPTED
  /// The teacher looked and the question was right after all.
  DISMISSED
}

model QuizAttempt {
  id        String         @id @default(cuid())
  quizId    String
  quiz      Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  answers            Json      @default("{}") // {questionId: optionId|text}
  scorePct           Int?
  passed             Boolean?
  needsManualGrading Boolean   @default(false)
  gradedAt           DateTime?
  gradedBy           String?
  startedAt          DateTime  @default(now())
  submittedAt        DateTime?
  /// Set when the teacher gives the student their attempts back. The row stays
  /// — it is the record of what was answered and when — but every count, pass
  /// check and time limit ignores it, so a student who ran out of attempts on a
  /// gated course is not locked out of a course they paid for with no way back.
  voidedAt           DateTime?
  /// What the teacher awarded each written question: {questionId: points}.
  ///
  /// Only the final percentage used to be kept, so a marked paper could not say
  /// what any single answer had earned — not to the teacher rereading it, not
  /// to the student, and not to a regrade trying to recompute the paper. The
  /// mark was made and then thrown away.
  manualScores       Json?
  /// Per-question verdicts from the AI marker, so a teacher regrading can see
  /// what it judged and why: {questionId: {similarityPct, reason}}.
  aiFeedback         Json?

  @@index([quizId, studentId])
}

model Assignment {
  id       String    @id @default(cuid())
  lessonId String    @unique
  lesson   Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  prompt   String
  dueAt    DateTime?
  maxScore Int       @default(100)

  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String         @id @default(cuid())
  assignmentId String
  assignment   Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  body      String    @default("")
  fileKey   String?
  score     Int?
  feedback  String?
  gradedAt  DateTime?
  createdAt DateTime  @default(now())

  @@unique([assignmentId, studentId])
}

// ─────────────────────────── Challenges (gamified) ─────────────────────────
//
// The student-facing "Challenge" — never "Exam" in any UI copy. Deliberately
// not built on Quiz: a Quiz is bound 1:1 to a Lesson, is single-player, and has
// no notion of speed, topic tags or per-question difficulty. A Challenge is a
// standalone, replayable, gamified question set a teacher publishes; it can
// optionally reference a course for context but never requires one.
//
// Async and self-paced by design (Quizizz/Blooket-solo style), not a live
// Kahoot-hosted synchronized room — docs/GAMIFICATION.md already documents
// that matchmaking/live-battle infrastructure was deliberately deferred, and
// nothing in this shape needs it: XP, coins and rank flow through the existing
// gamification engine exactly like a quiz does.

enum ChallengeType {
  PRACTICE
  RANKED
}

enum ChallengeStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  CLOSED
  ARCHIVED
}

enum ChallengeScoring {
  STANDARD
  SPEED_BASED
}

enum ChallengeAnswerReveal {
  IMMEDIATE
  AFTER_SUBMISSION
  AFTER_CLOSE
  NEVER
}

enum ChallengeRandomize {
  NONE
  QUESTIONS
  ANSWERS
  BOTH
}

enum ChallengeAttemptStatus {
  IN_PROGRESS
  COMPLETED
  TIMED_OUT
  ABANDONED
}

model Challenge {
  id       String         @id @default(cuid())
  tenantId String
  teacher  TeacherProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title       String
  description String          @default("")
  /// Material Symbols icon name, shown on the challenge card.
  coverIcon   String          @default("bolt")
  type        ChallengeType   @default(PRACTICE)
  status      ChallengeStatus @default(DRAFT)
  /// 1 (easiest) – 5 (hardest). Shown to students on the card; never scored.
  difficulty  Int             @default(1)

  courseId  String?
  course    Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  subjectId String?
  subject   Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  gradeId   String?
  grade     GradeLevel? @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  /// Free-text unit/topic label — a course isn't mandatory, so this is how a
  /// teacher tags what a standalone challenge is about.
  topic     String?

  /// Whole-challenge time budget in seconds; null = no overall limit.
  durationSec        Int?
  /// Default per-question time budget in seconds; null = no per-question
  /// timer unless a question overrides it. Server-authoritative, same pattern
  /// as Quiz.timeLimitSec — the client countdown is a courtesy, not the rule.
  questionTimeSec    Int?
  scoring            ChallengeScoring      @default(STANDARD)
  /// 0 = unlimited attempts.
  maxAttempts        Int                   @default(1)
  leaderboardEnabled Boolean               @default(true)
  answerReveal       ChallengeAnswerReveal @default(AFTER_SUBMISSION)
  randomize          ChallengeRandomize    @default(NONE)

  publishedAt DateTime?
  closesAt    DateTime?
  archivedAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt DateTime?

  questions ChallengeQuestion[]
  attempts  ChallengeAttempt[]

  @@index([tenantId, status])
  @@index([status, publishedAt])
  @@index([courseId])
}

model ChallengeQuestion {
  id          String    @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  type             QuestionType @default(MCQ)
  prompt           String
  imageUrl         String?
  options          Json         @default("[]") // [{id, text}]
  correctOptionIds String[]     @default([])
  explanation      String       @default("")

  /// Base XP this question is worth when answered correctly — the input to
  /// the scoring engine's speed-bonus multiplier (see ChallengeScoringService),
  /// not a raw quiz "point".
  points       Int     @default(100)
  /// Overrides Challenge.questionTimeSec for this one question; null = inherit.
  timeLimitSec Int?
  topic        String?
  /// 1–5, independent of the challenge's own difficulty — lets a teacher mix
  /// easy warm-ups with a few hard questions in one challenge.
  difficulty   Int     @default(1)
  sortOrder    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers ChallengeAnswer[]

  @@index([challengeId, sortOrder])
}

model ChallengeAttempt {
  id          String         @id @default(cuid())
  challengeId String
  challenge   Challenge      @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  attemptNumber Int                    @default(1)
  status        ChallengeAttemptStatus @default(IN_PROGRESS)

  /// The exact question ids and order this attempt is playing, decided once at
  /// creation (applying the challenge's randomize setting) and never
  /// recomputed — so a reload or reconnect sees the same order instead of a
  /// fresh shuffle. Also what a "retry my mistakes" attempt uses to restrict
  /// play to a specific subset of questions (see retryOfAttemptId).
  questionIds      String[] @default([])
  /// Set when this attempt only exists to retry the wrong answers of an
  /// earlier completed attempt — see ChallengesService.retryMistakes.
  retryOfAttemptId String?

  /// Anchors the server-authoritative timer — same role as QuizAttempt.startedAt.
  startedAt   DateTime  @default(now())
  /// Server deadline computed from Challenge.durationSec at start; null = no
  /// whole-attempt limit. A submission after this is rejected as TIMED_OUT.
  deadlineAt  DateTime?
  completedAt DateTime?

  /// Sum of per-answer xpAwarded — the "final score" shown on the result screen.
  score        Int  @default(0)
  correctCount Int  @default(0)
  wrongCount   Int  @default(0)
  accuracyPct  Int? // correctCount / questions answered, 0-100
  /// Average of (1 - timeUsed/timeAllowed) across answered questions, 0-100.
  speedPct     Int?

  /// What was actually handed to GamificationService.record() for this attempt.
  xpAwarded    Int @default(0)
  coinsAwarded Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers ChallengeAnswer[]

  @@unique([challengeId, studentId, attemptNumber])
  @@index([challengeId, status])
  @@index([studentId, status])
  @@index([challengeId, score])
}

model ChallengeAnswer {
  id         String            @id @default(cuid())
  attemptId  String
  attempt    ChallengeAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   ChallengeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedOptionIds String[] @default([])
  isCorrect         Boolean  @default(false)
  /// Milliseconds from the question becoming visible to the server receiving
  /// this answer. Clamped server-side against the allowed time — never trusted
  /// from the client beyond that clamp (see ChallengeScoringService).
  timeTakenMs       Int?
  xpAwarded         Int      @default(0)

  answeredAt DateTime @default(now())

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// ─────────────────────────── Social & Comms ────────────────────────────────

model Review {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenantId  String
  teacher   TeacherProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courseId  String?
  course    Course?        @relation(fields: [courseId], references: [id])

  rating    Int // 1–5
  comment   String    @default("")
  createdAt DateTime  @default(now())
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt DateTime?

  @@unique([studentId, tenantId, courseId])
  @@index([tenantId])
}

enum ChatThreadType {
  DM // direct student↔teacher chat
  QA // Q&A, optionally pinned to a lesson timestamp
}

model ChatThread {
  id                String         @id @default(cuid())
  type              ChatThreadType @default(DM)
  tenantId          String
  teacher           TeacherProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId         String
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // Q&A pinned to a moment in a video
  lessonId          String?
  videoTimestampSec Int?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  /// Where each side's view of this conversation starts.
  ///
  /// Clearing a chat is not hiding it and not deleting it: it draws a line, and
  /// from then on that person only sees what was said after the line. The other
  /// side's copy is untouched — the messages are the record of what was agreed
  /// about money and access, and one person tidying up cannot take that from
  /// the other. A new message appears after the line, so the conversation comes
  /// back carrying only what is new.
  clearedForTeacherAt DateTime?
  clearedForStudentAt DateTime?

  messages  ChatMessage[]
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt DateTime?

  @@index([tenantId, updatedAt])
  @@index([studentId, updatedAt])
}

model ChatMessage {
  id       String     @id @default(cuid())
  threadId String
  thread   ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId String
  sender   User       @relation(fields: [senderId], references: [id])
  /// Empty only when the message is a voice note, which carries no text.
  body     String
  readAt   DateTime?

  /// The message this one answers. Kept as a relation rather than a copied
  /// snippet so an edit or a delete upstream is reflected, and self-referential
  /// so a reply to a reply costs nothing extra.
  replyToId String?
  replyTo   ChatMessage?  @relation("ChatReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ChatMessage[] @relation("ChatReply")

  /// The lesson this message is about, and where in its video. A question asked
  /// from inside a lesson used to open a whole second conversation with the same
  /// teacher, which is two chats with one person; the context belongs to the
  /// message, not to the room.
  lessonId          String?
  lesson            Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  videoTimestampSec Int?

  /// A voice note. The audio is private — it is a conversation between two
  /// people — so only the storage key lives here and the bytes are served by a
  /// route that checks the listener is in the thread. There is no public URL.
  audioKey         String?
  audioDurationSec Int?
  audioBytes       Int?
  audioMimeType    String?

  createdAt DateTime  @default(now())
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt DateTime?

  @@index([threadId, createdAt])
  @@index([lessonId])
}

enum AnnouncementScope {
  PLATFORM // super admin broadcast to everyone
  TENANT // teacher broadcast to their students
}

model Announcement {
  id        String            @id @default(cuid())
  scope     AnnouncementScope
  tenantId  String?
  teacher   TeacherProfile?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title     String
  body      String
  createdBy String
  createdAt DateTime          @default(now())
}

enum NotificationType {
  ANNOUNCEMENT
  ENROLLMENT_APPROVED
  NEW_LESSON
  CHAT_MESSAGE
  QUIZ_GRADED
  PAYOUT_STATUS
  SECURITY_ALERT
  LIVE_SESSION_REMINDER
  SUBSCRIPTION_RENEWAL
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String           @default("")
  meta      Json             @default("{}")
  readAt    DateTime?
  createdAt DateTime         @default(now())
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt DateTime?

  @@index([userId, readAt, createdAt])
}

/// Where a session is in its life, as the teacher drove it.
///
/// Only the transitions a person actually makes are stored. "It is past its
/// window" is not one of them — that is a fact about the clock, derived on
/// read, so a session nobody bothered to end never sits in the wrong state
/// waiting for a cron job that might not run.
enum LiveSessionStatus {
  SCHEDULED
  LIVE
  ENDED
}

model LiveSession {
  id          String            @id @default(cuid())
  tenantId    String
  teacher     TeacherProfile    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courseId    String?
  title       String
  description String            @default("")
  startsAt    DateTime
  durationMin Int               @default(60)
  // null = unlimited seats
  capacity    Int?
  /// An external meeting link (Zoom, Meet) the teacher pasted in themselves.
  /// Predates the built-in classroom and still works: a session that has one
  /// and no room of its own keeps sending students there.
  joinUrl     String?
  status      LiveSessionStatus @default(SCHEDULED)
  /// The Daily room backing this session. Created when the teacher starts it,
  /// not when they schedule it — a room booked weeks ahead is a room sitting
  /// open weeks ahead, and the session may never run at all.
  roomName    String?           @unique
  roomUrl     String?
  startedAt   DateTime?
  endedAt     DateTime?

  /// Recording, transcript and summary: three stages of the same pipeline, so
  /// each carries its own state rather than one flag trying to describe all of
  /// them. A class can be recorded and never summarised, or summarised from a
  /// transcript whose recording has since been deleted.
  recordingStatus    LivePipelineStatus @default(NOT_STARTED)
  /// Daily's id for the recording. The download link is fetched fresh and
  /// short-lived when someone is allowed to watch — never stored, because a
  /// stored URL is a permanent public one the moment it leaks.
  recordingId        String?
  recordingStartedAt DateTime?
  /// Seconds, as the provider reported them once processing finished.
  recordingDuration  Int?

  transcriptStatus LivePipelineStatus @default(NOT_STARTED)
  /// The spoken text the summary is built from. Kept because the summary can be
  /// regenerated and the provider's copy expires.
  transcriptText   String?

  summaryStatus      LivePipelineStatus @default(NOT_STARTED)
  /// The structured summary, exactly as the schema the model was held to.
  summary            Json?
  summaryError       String?
  /// Off by default. A summary is the teacher's notes on their own lesson
  /// until they decide otherwise — and a bad first draft should not be
  /// published to a class before they have read it.
  summaryForStudents Boolean            @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  bookings   LiveBooking[]
  attendance LiveAttendance[]
  messages   LiveChatMessage[]

  @@index([tenantId, startsAt])
  @@index([tenantId, status])
}

/// One shape for the three things that happen to a session after it ends.
///
/// Deliberately not the job's status: a job can be retried, and what the
/// teacher's page needs to say is what exists, not how many attempts it took.
enum LivePipelineStatus {
  NOT_STARTED
  PROCESSING
  READY
  FAILED
}

/// A message sent inside the classroom.
///
/// Separate from `ChatThread`/`ChatMessage` on purpose: that is a conversation
/// between exactly two people (see the one-chat-per-pair migration), and this is
/// a room with a class in it. Reusing it would have meant either loosening that
/// invariant or inventing a thread per pair per session — both worse than one
/// small table. The realtime path is shared, which is the part worth sharing.
model LiveChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

/// Who was actually in the room, and for how long.
///
/// One row per person per session, so a refresh, a dropped connection or a
/// second tab extends the record they already have instead of inventing a new
/// attendance. Duration accumulates from heartbeats rather than from
/// `leftAt - joinedAt`: a student who joins, closes the laptop for an hour and
/// comes back for the last five minutes was present for ten minutes, not
/// seventy, and the browser cannot be trusted to say so on its way out.
model LiveAttendance {
  id              String      @id @default(cuid())
  sessionId       String
  session         LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// TEACHER or STUDENT, decided by the server from the JWT — never sent up.
  role            Role
  joinedAt        DateTime    @default(now())
  /// Last heartbeat. Also how a session works out who is still in the room.
  lastSeenAt      DateTime    @default(now())
  leftAt          DateTime?
  durationSeconds Int         @default(0)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

// A student's seat reservation for a live session.
model LiveBooking {
  id        String         @id @default(cuid())
  sessionId String
  session   LiveSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model Certificate {
  id          String         @id @default(cuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  serial      String         @unique // e.g. DRS-CERT-2026-000123 — human-readable, for display
  // Unguessable public-verification token. The public verify endpoint looks up by
  // this token instead of the sequential serial, so certificates can no longer be
  // enumerated. Nullable only to allow a zero-downtime backfill of existing rows.
  verifyToken String?        @unique
  pdfKey      String?
  issuedAt    DateTime       @default(now())
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt   DateTime?

  @@unique([studentId, courseId])
}

// ─────────────────────────── Platform ops ──────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation("actor", fields: [actorUserId], references: [id])
  action      String // e.g. teacher.approve, payout.complete, enrollment.revoke
  entity      String
  entityId    String?
  // Nullable: not every audited action is academy-scoped (e.g. a student's own
  // WalletTopup, or global catalog Subject/GradeLevel edits), and older rows
  // predate this column — backfilled where derivable, left null otherwise.
  academyId   String?
  meta        Json     @default("{}")
  ip          String?
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
  @@index([entity, entityId])
  @@index([academyId, createdAt])
}

// Global key-value platform settings editable by super admin.
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─────────────────────────── Academy Studio (AI Site) ──────────────────────
// Phase 1: AI-generated academy landing pages. Every model/column here is
// additive and nullable so the migration is safe to apply on non-empty prod
// tables (no backfill, no NOT NULL without default). Gated by AI_ACADEMY_ENABLED.

enum AiJobType {
  SITE_GENERATE
  /// Summarise a finished live session from its transcript.
  LIVE_SUMMARY
}

enum AiJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum AcademySiteStatus {
  DRAFT
  PENDING_MODERATION
  PUBLISHED
  REJECTED
}

enum AcademyMediaKind {
  LOGO
  COVER
  GALLERY
  PROMO
  AVATAR
  /// A course's own intro clip. Academy-scoped like every other media row —
  /// the course points at it — so one teacher's clips never leave their tenant.
  COURSE_INTRO
}

enum AcademyMediaStatus {
  UPLOADING
  PROCESSING
  READY
  REJECTED
}

enum AcademyClaimState {
  UNVERIFIED
  ADMIN_VERIFIED
  REJECTED
}

// Structured, editable "facts" the AI generates copy from (kept separate from
// the rendered presentation so facts vs. wording never drift).
model AcademyProfileFacts {
  id           String    @id @default(cuid())
  academyId    String    @unique
  academy      Academy   @relation(fields: [academyId], references: [id], onDelete: Cascade)
  fullName     String?
  bio          String?
  subjects     Json      @default("[]")
  stages       Json      @default("[]")
  achievements Json      @default("[]")
  socials      Json      @default("[]")
  rawIntake    String? // freeform onboarding text the teacher pasted
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt    DateTime?
}

// One landing site per academy. draftDoc is the working Site Document; on
// approval it is compiled to publishedHtml. `version` doubles as the ETag.
model AcademySite {
  id                 String            @id @default(cuid())
  academyId          String            @unique
  academy            Academy           @relation(fields: [academyId], references: [id], onDelete: Cascade)
  status             AcademySiteStatus @default(DRAFT)
  version            Int               @default(0)
  draftDoc           Json? // working Site Document
  publishedDoc       Json? // last approved Site Document
  publishedHtml      String? // compiled HTML served at /a/:slug (Postgres text)
  htmlLocked         Boolean           @default(false) // publishedHtml is hand-authored — publish/recompile must never regenerate it
  /// The hand-authored page kept aside when the studio takes over, so handing
  /// it back is reversible. Without this the handover was one-way: the compiled
  /// markup overwrote the page someone had written, and there was nothing to
  /// put back.
  handAuthoredHtml   String?
  moderationApproved Boolean           @default(false)
  moderatedById      String?
  moderationReason   String?
  publishedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  snapshots AcademySiteSnapshot[]
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt DateTime?

  @@index([status])
}

// Immutable version history for rollback. GC keeps the last N + the published one.
model AcademySiteSnapshot {
  id        String      @id @default(cuid())
  siteId    String
  site      AcademySite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  version   Int
  doc       Json
  reason    String? // generate | manual-save | pre-publish | pre-rollback
  createdAt DateTime    @default(now())
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt DateTime?

  @@index([siteId, createdAt])
}

// Uploaded/processed media (logos, covers, gallery, promo video, avatars).
model AcademyMedia {
  id           String             @id @default(cuid())
  academyId    String
  academy      Academy            @relation(fields: [academyId], references: [id], onDelete: Cascade)
  kind         AcademyMediaKind
  status       AcademyMediaStatus @default(UPLOADING)
  storageKey   String? // key inside StorageProvider
  url          String? // public URL once READY
  mimeType     String?
  bytes        Int?
  width        Int?
  height       Int?
  blurhash     String?
  contentHash  String? // dedupe identical uploads
  rejectReason String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt    DateTime?

  @@index([academyId, kind])
  @@index([academyId, status])
  @@index([contentHash])
}

// DB-backed job queue (no Redis). Claimed with FOR UPDATE SKIP LOCKED; a
// crashed RUNNING job is re-claimable once leaseExpiresAt passes.
model AiJob {
  id               String      @id @default(cuid())
  academyId        String
  academy          Academy     @relation(fields: [academyId], references: [id], onDelete: Cascade)
  type             AiJobType
  status           AiJobStatus @default(QUEUED)
  input            Json        @default("{}")
  stage            String? // extract | brand | copy | assemble
  attempts         Int         @default(0)
  leaseExpiresAt   DateTime?
  errorClass       String? // RETRYABLE | TERMINAL
  error            String?
  costCents        Int         @default(0)
  resultSnapshotId String? // loose ref to AcademySiteSnapshot
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  /// Soft delete: rows with deletedAt set are hidden from all reads.
  deletedAt        DateTime?

  @@index([status, createdAt])
  @@index([academyId, createdAt])
}

// High-stakes claims (student counts, ratings, awards) that must be admin-verified
// before they can appear on a published page.
model AcademyClaim {
  id              String            @id @default(cuid())
  academyId       String
  academy         Academy           @relation(fields: [academyId], references: [id], onDelete: Cascade)
  kind            String // student_count | rating | award | ...
  value           String
  state           AcademyClaimState @default(UNVERIFIED)
  evidenceMediaId String? // loose ref to AcademyMedia
  reviewedById    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([academyId, state])
}

// ------------------------- SMS Listener (device) ----------------------------
// A compliant, user-authorized SMS-monitoring companion app (RECEIVE_SMS +
// BroadcastReceiver -- NOT notification/accessibility scraping). It authenticates
// the phone by OTP, then posts payment-relevant SMS as device events that feed
// the SAME PaymentMatchingService as the legacy X-Listener-Key path.
// Deliberately independent of User/Role: a listener phone is not a marketplace
// account, so device auth never touches DeviceSession/Role.

model ListenerDevice {
  id               String    @id @default(cuid())
  // Verified via OTP, stored E.164 (+2010xxxxxxxx).
  phone            String
  platform         String    @default("android")
  model            String? // e.g. "Pixel 7" -- best-effort, for the admin/device list
  appVersion       String?
  // Single active refresh token per device (argon2 hash). Rotation replaces it;
  // presenting a stale refresh token => reuse => the device is revoked.
  refreshTokenHash String?
  revokedAt        DateTime?
  revokedReason    String?
  lastSeenAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())

  smsEvents DeviceSmsEvent[]

  @@index([phone, revokedAt])
}

enum SenderMatchType {
  EXACT // sender id equals `pattern` (case-insensitive)
  CONTAINS // sender id contains `pattern`
  REGEX // sender id matches `pattern` as a regular expression
}

// Backend-driven sender classification. The app pulls these so business logic
// (which senders forward, and to which provider) is never hard-coded in the APK.
// SMS sender IDs (alphanumeric "CIB", "VodafoneCash", short codes) rarely equal
// the brand name exactly -- hence the match types.
model SenderRule {
  id               String          @id @default(cuid())
  brand            String // display label, e.g. "CIB", "Vodafone Cash"
  matchType        SenderMatchType @default(CONTAINS)
  pattern          String // matched against the normalized SMS sender id
  provider         PaymentMethod // which payment provider a match maps to
  enabled          Boolean         @default(true)
  forwardToBackend Boolean         @default(true)
  priority         Int             @default(100) // lower wins when several rules match
  updatedAt        DateTime        @updatedAt
  createdAt        DateTime        @default(now())

  @@index([enabled, priority])
}

// The server-side mirror of the device outbox -- the second idempotency layer.
// The app dedupes locally on messageHash; the backend ALSO enforces
// UNIQUE(deviceId, messageHash) so a retried POST can never double-forward.
model DeviceSmsEvent {
  id             String         @id @default(cuid())
  deviceId       String
  device         ListenerDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  sender         String
  // SHA-256(normalizedSender + ' ' + body + ' ' + receivedAtEpochSec).
  messageHash    String
  receivedAt     DateTime
  simSlot        Int?
  subscriptionId Int?
  // Classification outcome (server-authoritative; re-derived from rawMessage).
  brand          String?
  provider       PaymentMethod?
  amountCents    Int?
  reference      String?
  forwarded      Boolean        @default(false) // did we hand it to PaymentMatchingService?
  paymentEventId String? // the resulting PaymentEvent, when forwarded
  matchStatus    String? // MATCHED | UNMATCHED | AMBIGUOUS | DUPLICATE | LOCAL_ONLY
  createdAt      DateTime       @default(now())

  @@unique([deviceId, messageHash])
  @@index([deviceId, receivedAt])
}

// Admin-issued enrollment code — how a listener phone joins, without SMS.
//
// The platform has no SMS gateway, so an OTP cannot be delivered in production.
// It also isn't the right control here: the listener runs on a phone the operator
// physically owns, so the question is not "does this person control this number?"
// but "did an admin authorise this handset?". A super-admin mints a short-lived,
// single-use code bound to the phone number the device will report, and the app
// exchanges it for device tokens. Codes are argon2-hashed, so the database never
// holds a usable one.
model DeviceEnrollmentCode {
  id                 String    @id @default(cuid())
  // The number this code will register, E.164. Bound at mint time by the admin,
  // so the device can never claim a different one.
  phone              String
  codeHash           String
  label              String? // free-text note, e.g. "الموبايل بتاع الخزنة"
  expiresAt          DateTime
  consumedAt         DateTime?
  consumedByDeviceId String?
  attempts           Int       @default(0)
  createdById        String?
  createdAt          DateTime  @default(now())

  @@index([expiresAt, consumedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Gamification
//
// One engine behind every meaningful learning action: XP, coins, levels,
// achievements, missions and leaderboards. Three rules hold it together.
//
//  1. **One ledger.** `GamificationEvent` is the single, append-only record of
//     everything that ever awarded (or spent) XP and coins. Balances are
//     denormalised onto `StudentGamification` for cheap reads, but the ledger
//     is the truth, and every row is traceable to the learning action that
//     caused it.
//  2. **Idempotent by construction.** Every event carries a unique key derived
//     from what happened, not from when it was reported. A heartbeat that
//     re-reports a finished lesson, a retried request, a double-submitted quiz
//     — all collapse to one award, at the database level.
//  3. **Coins are not money.** They live here, in their own ledger, counted in
//     whole coins. The real-money wallet (`WalletTransaction`, piasters) is a
//     different table in a different module and the two never meet.
// ─────────────────────────────────────────────────────────────────────────────

/// Per-student aggregate: the numbers the profile and dashboard read.
/// Derived from the ledger, kept current inside the same transaction.
model StudentGamification {
  id        String         @id @default(cuid())
  studentId String         @unique
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  xp    Int @default(0)
  level Int @default(1)

  /// Spendable balance, and the lifetime totals behind it.
  coins       Int @default(0)
  coinsEarned Int @default(0)
  coinsSpent  Int @default(0)

  /// Counters the achievement engine evaluates against. Denormalised so
  /// unlocking never fans out into a dozen count() queries per event.
  lessonsCompleted    Int @default(0)
  quizzesPassed       Int @default(0)
  perfectQuizzes      Int @default(0)
  challengesCompleted Int @default(0)
  challengesWon       Int @default(0)
  perfectChallenges   Int @default(0)
  coursesCompleted    Int @default(0)
  assignmentsDone     Int @default(0)
  liveAttended        Int @default(0)
  reviewsWritten      Int @default(0)
  missionsCompleted   Int @default(0)
  earlyBirdSessions   Int @default(0)
  nightOwlSessions    Int @default(0)
  weekendSessions     Int @default(0)

  /// Streak protection. The streak itself stays on StudentProfile — this is
  /// only the inventory and the record of the last day a freeze was spent.
  streakFreezes Int       @default(0)
  freezeUsedOn  DateTime?

  /// The title the student chose to display beside their name.
  activeTitle   String?
  bestRank      Int?
  lastLevelUpAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The append-only ledger. Also the audit trail and the anti-abuse record.
model GamificationEvent {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// Academy the action belonged to. Null for platform-level events (daily
  /// login, level-up). Leaderboards scope on this.
  tenantId String?
  courseId String?

  type       String
  entityType String?
  entityId   String?

  xpAwarded    Int @default(0)
  /// Signed: positive when earned, negative when spent in the reward store.
  coinsAwarded Int @default(0)

  /// Derived from the action, never from the request. Two reports of the same
  /// completion produce the same key and therefore one award.
  idempotencyKey String @unique

  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
  @@index([studentId, type])
  @@index([tenantId, createdAt])
  @@index([type, createdAt])
}

/// What each event is worth. Seeded with defaults; editable by an admin so the
/// economy can be tuned without a deploy.
model XpRule {
  id    String @id @default(cuid())
  event String @unique

  xp    Int @default(0)
  coins Int @default(0)

  /// Anti-farming. `dailyCap` is the most XP this event may produce for one
  /// student in a day (0 = uncapped); `perEntityLimit` how many times it may
  /// ever pay out for the same entity (0 = unlimited).
  dailyCap       Int @default(0)
  perEntityLimit Int @default(1)

  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

/// Level thresholds. Configurable, so the curve can be retuned later.
model LevelTier {
  level  Int    @id
  minXp  Int
  nameAr String
  nameEn String
  icon   String @default("military_tech")

  /// Paid once, on arrival.
  coinReward Int @default(0)
}

/// Achievement definitions, evaluated against a named counter so new ones can
/// be added as data rather than code.
model Achievement {
  id       String @id @default(cuid())
  key      String @unique
  category String

  icon    String
  titleAr String
  titleEn String
  descAr  String
  descEn  String

  /// A field of StudentGamification, or one of the derived metrics the
  /// evaluator knows (certificates, streakBest, enrollments, level…).
  metric    String
  threshold Int

  xpReward   Int     @default(0)
  coinReward Int     @default(0)
  /// Unlocks this title when earned.
  titleKey   String?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  students StudentAchievement[]
}

model StudentAchievement {
  id            String         @id @default(cuid())
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement    @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime       @default(now())

  @@unique([studentId, achievementId])
  @@index([studentId, unlockedAt])
}

/// Display titles. Separate from achievements: an achievement is a thing you
/// did, a title is a thing you wear.
model Title {
  key       String @id
  labelAr   String
  labelEn   String
  icon      String @default("workspace_premium")
  sortOrder Int    @default(0)

  students StudentTitle[]
}

model StudentTitle {
  id         String         @id @default(cuid())
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  titleKey   String
  title      Title          @relation(fields: [titleKey], references: [key], onDelete: Cascade)
  unlockedAt DateTime       @default(now())

  @@unique([studentId, titleKey])
}

/// A mission or quest assigned to one student for one period. Generated lazily
/// on first read of the day/week, from the courses that student is actually
/// enrolled in — so no scheduler, and no missions for content they don't have.
model StudentMission {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// 'DAILY' | 'WEEKLY'
  kind      String
  /// The period this belongs to: '2026-09-12' for a day, '2026-W37' for a week.
  periodKey String
  /// Template id — what the mission asks for.
  template  String

  target   Int
  progress Int @default(0)

  xpReward   Int @default(0)
  coinReward Int @default(0)

  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([studentId, periodKey, template])
  @@index([studentId, kind, periodKey])
}

/// Incrementally maintained leaderboard totals — written in the same
/// transaction as the award, so a board never has to be recomputed from the
/// full ledger to be read.
model LeaderboardEntry {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// 'GLOBAL' | 'ACADEMY' | 'COURSE'
  scope     String
  /// '' for global, else the tenant or course id.
  scopeId   String
  /// 'WEEKLY' | 'MONTHLY' | 'ALLTIME'
  period    String
  /// '2026-W37' | '2026-09' | 'all'
  periodKey String

  xp        Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([scope, scopeId, period, periodKey, studentId])
  @@index([scope, scopeId, period, periodKey, xp(sort: Desc)])
}

/// What coins can buy. Tenant-scoped rewards belong to one academy; a null
/// tenant is a platform-wide reward.
model Reward {
  id       String  @id @default(cuid())
  key      String  @unique
  tenantId String?

  category String
  /// What redeeming actually does: STREAK_FREEZE | XP_BOOST | COSMETIC | TITLE | REAL
  kind     String

  icon    String
  titleAr String
  titleEn String
  descAr  String @default("")
  descEn  String @default("")

  costCoins     Int
  /// Extra parameters for the effect (multiplier, duration, title key…).
  payload       Json    @default("{}")
  /// Null = unlimited.
  stock         Int?
  /// A real-world reward never fulfils itself; an admin has to act.
  needsApproval Boolean @default(false)

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  redemptions RewardRedemption[]

  @@index([tenantId, isActive])
}

model RewardRedemption {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rewardId  String
  reward    Reward         @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  costCoins Int
  /// FULFILLED for instant effects, PENDING when an admin must act.
  status    String   @default("FULFILLED")
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
  @@index([status, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Student Studio — the student's own copy of Darsly.
//
// A teacher customises their Academy; a student customises their Darsly. The
// two must not fight, so they own different namespaces: academy branding writes
// the `--c-*` tokens the whole product is built on, and a student's choices can
// only ever reach the `--s-*` tokens that the student's own surfaces read. That
// boundary is enforced on the server, which is the only place a colour is ever
// calculated — a student sends a key or a hex, never a token and never CSS.
// ─────────────────────────────────────────────────────────────────────────────

enum CosmeticCategory {
  THEME
  ACCENT
  BUTTON_STYLE
  CARD_STYLE
  NAV_STYLE
  HEADER_STYLE
  AVATAR
  FRAME
  EFFECT
}

/// Cosmetic only, and deliberately so: rarity says how much effort something
/// took, never how likely it is. Nothing here is random and nothing is a box.
enum CosmeticRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

model CosmeticItem {
  id       String           @id @default(cuid())
  key      String           @unique
  category CosmeticCategory
  rarity   CosmeticRarity   @default(COMMON)

  nameAr String
  nameEn String
  descAr String @default("")
  descEn String @default("")

  /// A closed vocabulary the server knows how to read — a palette, a shape
  /// name. Never CSS, never HTML, never anything the browser executes.
  config Json @default("{}")

  /// Coins buy cosmetics. XP is progression and is never spent: it gates what
  /// is available through `requiredLevel`, so unlocking a theme can never cost
  /// a student the level they earned.
  costCoins           Int     @default(0)
  requiredLevel       Int     @default(1)
  /// Granted outright by an achievement instead of bought.
  requiredAchievement String?
  /// Everyone has it from the first day: the baseline to customise away from.
  isStarter           Boolean @default(false)

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owners StudentCosmetic[]

  @@index([category, isActive, sortOrder])
  @@index([isActive, sortOrder])
}

/// Who owns what. Unique per pair, so buying twice is impossible at the
/// database rather than only in the code that meant to check.
model StudentCosmetic {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  itemId    String
  item      CosmeticItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// PURCHASE | ACHIEVEMENT | STARTER | GRANT — how it was come by.
  source    String   @default("PURCHASE")
  costCoins Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([studentId, itemId])
  @@index([studentId, createdAt])
}

/// What the student is currently wearing. One row per student, one slot per
/// category: a second theme cannot be equipped alongside the first.
model StudentCustomization {
  id        String         @id @default(cuid())
  studentId String         @unique
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  /// The academy whose colours this student chose to wear.
  ///
  /// A student with three teachers had no say in which one the app looked like —
  /// it was whichever they enrolled with first. This is that say, and it is also
  /// the way back: after trying a theme on, "my teacher's look" is one tap rather
  /// than a reset of everything.
  ///
  /// Mutually exclusive with `themeKey` by construction: equipping either clears
  /// the other, because wearing two looks at once is not a thing.
  academyId String?

  themeKey  String?
  accentKey String?
  /// A colour the student picked rather than unlocked, as plain hex. The safe
  /// variants around it are derived on the server, where the contrast floors
  /// live — the browser never decides a colour.
  accentHex String?
  buttonKey String?
  cardKey   String?
  navKey    String?
  /// The header's shape, bought and worn over whatever theme is on — the same
  /// rule as the sidebar and the buttons.
  headerKey String?
  avatarKey String?
  frameKey  String?
  effectKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
