# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://darsly:darsly_dev_password@localhost:5434/darsly?schema=public"

# ── API ───────────────────────────────────────────────────────────────────
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173
# Comma-separated origins allowed by CORS + the video domain-lock check
ALLOWED_ORIGINS=http://localhost:5173

# ── Redis (distributed rate limiting + Socket.IO cross-replica delivery) ──
# Production runs 2+ API replicas behind Railway's load balancer. Login/
# forgot-password throttling and Socket.IO room broadcasts both need state
# shared across them — without Redis each replica counts and rooms
# independently (a login rate limit of 20/min becomes ~40 in practice, and a
# chat message sent on one instance never reaches a recipient on another).
# REQUIRED in production — the API refuses to start without it there
# (common/config.validation.ts). Optional locally: unset, both features fall
# back to correct per-process behaviour, which is fine with exactly one
# instance. `docker compose up -d redis` if you want to exercise the real
# distributed path locally.
# If Redis is reachable at boot but drops out later, both features fail OPEN
# (rate limiting stops enforcing, Socket.IO stays single-instance) rather
# than failing the request or crashing — see docs/SYSTEM.md "Rate limiting".
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=900        # seconds (15 min)
JWT_REFRESH_TTL=2592000   # seconds (30 days)
# Dev OTP: when true, OTP codes are logged to console instead of sent via SMS
OTP_DEV_MODE=true
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# SMS-listener device auth (falls back to the JWT_*_TTL values above if unset).
# Access tokens are short-lived; the app stores both in the Android Keystore.
DEVICE_JWT_ACCESS_TTL=900       # seconds (15 min)
DEVICE_JWT_REFRESH_TTL=2592000  # seconds (30 days)

# ── Sessions & device control (Teacher-Security defaults) ────────────────
MAX_CONCURRENT_SESSIONS_DEFAULT=2

# ── Email (Resend) ────────────────────────────────────────────────────────
# Unset ⇒ mails are logged to the console instead of sent (dev seam).
RESEND_API_KEY=
# Must be an address on a domain verified in Resend. Before verification, the
# only sender that works is onboarding@resend.dev — and it delivers ONLY to the
# email address that owns the Resend account.
# Who gets "a teacher applied" mail (comma-separated). Falls back to super-admin accounts' emails.
ADMIN_NOTIFY_EMAILS=
MAIL_FROM=Darsly <onboarding@resend.dev>
# Optional: where replies to transactional mail should land.
MAIL_REPLY_TO=

# ── Video / streaming ─────────────────────────────────────────────────────
SIGNED_URL_TTL_SECONDS=300
HLS_KEY_ROTATION_SECONDS=3600
STORAGE_DRIVER=local           # local | s3
STORAGE_LOCAL_PATH=./storage
# S3-compatible bucket. Production is Cloudflare R2:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   (region becomes `auto` on its own)
#   S3_BUCKET=<bucket>   S3_ACCESS_KEY / S3_SECRET_KEY = an R2 API token with Object Read & Write
# The bucket stays private — the API streams every object itself and signs its
# own short-lived links. No public access, no custom domain. Locally these
# point at MinIO (docker compose up -d minio).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=darsly-media
S3_ACCESS_KEY=darsly
S3_SECRET_KEY=darsly_dev_password

# ── Payments ──────────────────────────────────────────────────────────────
PAYMENT_GATEWAY=mock           # mock | paymob | fawry | stripe
PLATFORM_COMMISSION_DEFAULT=20 # percent, overridable per-teacher by super admin
CURRENCY=EGP

# ── Web (Vite) ────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000
# LEGACY. The current SMS ingest path is POST /device/sms-events, which
# authenticates a per-device JWT (DeviceAuthGuard), checks the ListenerDevice
# row is still registered, and can be revoked one device at a time.
#
# Leave this UNSET. Unset means POST /payment-events answers 503 to everyone,
# which is what production does today. Setting it re-opens a shared secret that
# every device would hold in common and that cannot be revoked individually —
# only set it to run the simulator, and only outside production.
PAYMENT_LISTENER_KEY=

# ── Academy (workspace) layer ─────────────────────────────────────────────
# Feature flag for the academy context + membership/permission guards (Phase 2).
# Set to "false" to kill-switch the academy-aware endpoints during rollout.
ACADEMY_CONTEXT_ENABLED=true

# ── Academy Studio (AI site generation) ───────────────────────────────────
# Master kill-switch for the whole AI-site feature. Ships OFF; flip to "true"
# only after the media pipeline is deployed AND (in prod) STORAGE_DRIVER=s3,
# OPENAI_API_KEY and AI_MODEL are set — config validation enforces this.
AI_ACADEMY_ENABLED=false
# Backend-only OpenAI credential. Never expose this to the frontend.
OPENAI_API_KEY=
AI_MODEL=gpt-5
# Model token prices in cents per million tokens (set to your model's pricing).
AI_PRICE_IN_PER_MTOKEN=300
AI_PRICE_OUT_PER_MTOKEN=1500
# Month-to-date generation spend ceiling; generation is refused past this.
AI_MONTHLY_BUDGET_CENTS=50000
# Background worker: set false on replicas that should not process jobs.
WORKER_ENABLED=true
WORKER_CONCURRENCY=3

# ── Paper exam import ─────────────────────────────────────────────────────
# Rides the same kill-switch (AI_ACADEMY_ENABLED), the same queue, the same
# budget ceiling and the same OPENAI_API_KEY as the site generator. Needs
# poppler-utils on the host for PDFs (already in the Dockerfile).
#
# Two models, and the whole cost story is which one reads a page. The primary
# reads every page; the fallback re-reads only the pages the primary got
# demonstrably wrong. Watch PaperImport.escalatedPages — if it stops being a
# small fraction, the primary is the wrong model, not the strategy.
PAPER_IMPORT_PRIMARY_MODEL=gpt-6-luna
PAPER_IMPORT_FALLBACK_MODEL=gpt-6-sol
# The third tier, and the only one no rule ever reaches: it runs when a teacher
# looks at a bad result and presses "read it again more carefully". That is for
# the paper the other two cannot read — decades-old handwriting, faded ink —
# and it costs about twenty times the fallback, so a person decides, not a
# heuristic.
PAPER_IMPORT_STRONG_MODEL=gpt-6-astra
# Cents per million tokens, per model. Defaults are the published prices for
# the models above; change them when the provider's prices change, not the
# code.
PAPER_IMPORT_PRIMARY_PRICE_IN=10
PAPER_IMPORT_PRIMARY_PRICE_OUT=50
PAPER_IMPORT_FALLBACK_PRICE_IN=200
PAPER_IMPORT_FALLBACK_PRICE_OUT=1000
PAPER_IMPORT_STRONG_PRICE_IN=1000
PAPER_IMPORT_STRONG_PRICE_OUT=5000
# How hard each model thinks. Reading printed text off a picture is not a
# reasoning problem; reading a difficult page is, and what resolves an unclear
# word is reading the words around it — which is what the effort pays for.
PAPER_IMPORT_PRIMARY_EFFORT=low
PAPER_IMPORT_FALLBACK_EFFORT=high
PAPER_IMPORT_STRONG_EFFORT=high
# Ceilings. maxPages is a bill as much as a limit.
PAPER_IMPORT_MAX_PAGES=25
PAPER_IMPORT_MAX_IMAGE_SIZE=15728640
PAPER_IMPORT_MAX_PDF_SIZE=41943040
# How hard the provider looks at the page. `original` is what its own vision
# guide recommends for reading text and small detail; `high` is for pictures
# that are being looked at rather than read.
PAPER_IMPORT_IMAGE_DETAIL=original
# How big a page is worth sending, in the 32x32 patches image tokens are
# actually counted in. Sizing to the model's budget rather than to a flat pixel
# count means an A4 scan and a phone snapshot both arrive at the resolution the
# model can use. ~2500 patches is ~3000 image tokens: a third of a cent per
# page on the primary model.
PAPER_IMPORT_PATCH_BUDGET=2500
# Hard ceiling on the long edge, whatever the budget works out to.
PAPER_IMPORT_RENDER_DIM=2400
# JPEG quality of the page that is sent. Free — image tokens come from the
# pixel dimensions, not the file size — so compressing harder costs the same
# and only loses handwriting.
PAPER_IMPORT_RENDER_QUALITY=92
# Output ceiling per page.
PAPER_IMPORT_MAX_TOKENS=6000

# ── Reading a page ────────────────────────────────────────────────────────
# Transcription is several passes rather than one call, and these decide how
# many. At or above ACCEPT a region is taken as read; below VERIFY it is
# cropped from the original and read again at several times the resolution —
# which costs the same, because image tokens are counted in 32x32 patches and
# a crop has fewer of them to spend on less of the page.
PAPER_IMPORT_OCR_ACCEPT=0.9
PAPER_IMPORT_OCR_VERIFY=0.7
# How many re-reads one region gets before what is left is marked unreadable.
PAPER_IMPORT_OCR_REGION_PASSES=2
# Past this many bad regions the page is re-read whole instead: a page where
# everything is doubtful is a bad page, and crops of all of it cost more.
PAPER_IMPORT_OCR_MAX_CROPS=6
# How many flagged numbers inside one region get their own crop. A digit is
# the highest-risk thing on an exam paper and the cheapest thing to check.
PAPER_IMPORT_OCR_MAX_FRAGMENTS=3
# Back to one call per page, for the day a provider changes under us.
PAPER_IMPORT_OCR_MULTIPASS=true
# The stored working copy every crop is taken from. Deliberately larger than
# anything one call can use: storing a page already squeezed to a page-sized
# budget would throw away the detail that makes re-reading work.
PAPER_IMPORT_STORED_DIM=3000
PAPER_IMPORT_STORED_QUALITY=90

# ── Writing an exam from lecture material ─────────────────────────────────
# The studio's second path. Reading a lecture page is the same job as reading
# an exam page, so it uses the two models above and needs nothing of its own.
# Writing questions is a different job and gets its own model: the middle tier,
# because transcribing is copying and writing a fair question with a defensible
# key is not — and because the flagship at ~20x the price is reserved for a
# batch that has already failed, or for a teacher who asked.
PAPER_IMPORT_GENERATION_MODEL=gpt-6-sol
PAPER_IMPORT_GENERATION_PRICE_IN=200
PAPER_IMPORT_GENERATION_PRICE_OUT=1000
PAPER_IMPORT_GENERATION_EFFORT=medium
# Questions per model call. Never one call per question: that pays for the same
# instructions and the same source material once per question, and it is how a
# model writes the same question twice without knowing it.
PAPER_IMPORT_BATCH_SIZE=8
# Source material sent with one batch, in approximate tokens — the biggest
# single lever on what generating an exam costs.
PAPER_IMPORT_BATCH_SOURCE_TOKENS=6000
# How many times a batch that fails the deterministic checks is written again
# before the shortfall is simply reported to the teacher.
PAPER_IMPORT_GENERATION_ATTEMPTS=2
# A lecture may be longer than an exam. Past this a teacher is uploading a book.
PAPER_IMPORT_MAX_CONTENT_PAGES=60
# Characters of real text a PDF page must carry before its text layer is read
# instead of its picture. Below this it is a scan, and the picture is sent.
PAPER_IMPORT_TEXT_LAYER_MIN=250
# Require admin approval before a first site publish goes public. Off by default
# (publishes go live immediately; admins can still take a site down).
ACADEMY_SITE_MODERATION=false

# ── XPay (card payments) ──────────────────────────────────────────────────────
# Off until a secret key exists, so a missing key can never be a live failure.
XPAY_ENABLED=false
XPAY_SECRET_KEY=
# The webhook is public — XPay has no session with us — so this secret is the
# only thing between the endpoint and a stranger granting themselves a course.
# With no value set, every webhook is rejected.
XPAY_WEBHOOK_SECRET=
# ── VERIFY these four against your XPay Developer hub before going live ───────
# They are env values rather than constants precisely because the public docs
# do not publish them; correcting one is a config change, not a code change.
XPAY_BASE_URL=https://api.xpay.app/v1
XPAY_AUTH_HEADER=Authorization
XPAY_AUTH_FORMAT=Bearer {key}
XPAY_SIGNATURE_HEADER=x-xpay-signature
XPAY_SIGNATURE_ALGO=sha256
# Where the student lands after paying.
XPAY_RETURN_URL=
XPAY_CANCEL_URL=

# ── Live classrooms: which provider ───────────────────────────────────────
# New classes run on LIVE_PROVIDER: cloudflare (default) or daily. A class keeps
# the provider it was created with, so changing this moves new classes only.
# With cloudflare selected and its credentials missing the API refuses to
# start — it never quietly falls back to Daily.
LIVE_PROVIDER=cloudflare
# How many students may speak at once (raise hand → approved). Default 3.
LIVE_MAX_SPEAKERS=

# ── Live classrooms (Cloudflare Realtime SFU) ─────────────────────────────
# The app secret is server-only: every WebRTC push/pull goes through the API's
# own RTC endpoints, which check the class before calling Cloudflare. Never a
# VITE_ variable (those ship to every browser) — the API refuses to boot in
# production if one looks like a provider secret.
# https://dash.cloudflare.com → Realtime → SFU → your app.
CF_REALTIME_APP_ID=
CF_REALTIME_APP_SECRET=
# TURN (relay for networks that block UDP) needs its own TURN key — the SFU
# secret is not accepted by the TURN service. Without these: STUN only.
CF_TURN_KEY_ID=
CF_TURN_KEY_API_TOKEN=

# ── Live recorder (Cloudflare classes) ────────────────────────────────────
# Darsly records Cloudflare classes itself, in headless Chromium. Run it as
# its own service (Dockerfile.recorder sets these); keep it off on the API.
LIVE_RECORDER_ENABLED=false
CHROME_PATH=
# Pieces are uploaded as they close; a crash loses at most one piece.
LIVE_RECORDER_SEGMENT_MIN=10
LIVE_RECORDER_CONCURRENCY=2
LIVE_RECORDER_DIR=

# ── Live transcript (Cloudflare classes) ──────────────────────────────────
# The teacher's page captures the lesson's voices (their mic + approved
# speakers) in 3-minute pieces; after the class one LIVE_TRANSCRIBE job turns
# them into the transcript the summary is written from, then deletes the audio.
# OFF by default — every lesson is a paid speech-to-text call. Needs
# OPENAI_API_KEY and the AI queue (AI_ACADEMY_ENABLED=true, WORKER_ENABLED).
# Spend counts toward AI_MONTHLY_BUDGET_CENTS.
LIVE_TRANSCRIPTION_ENABLED=false
# gpt-4o-mini-transcribe (default) or gpt-4o-transcribe — pick by running
# apps/api/scripts/transcription-bench on a real lesson sample.
LIVE_STT_MODEL=
# The mode new classes start with: AUTO_WHEN_RECORDING (default: capture follows
# the record button), MANUAL (the teacher switches it in the classroom) or OFF.
# The teacher can change it per class; nothing is captured while the switch
# above is off.
LIVE_TRANSCRIPTION_DEFAULT_MODE=
# Audio that never became a transcript (queue refused, class cancelled, a late
# piece) is deleted this many hours after upload. Successful transcripts delete
# their audio at once. Default 24.
LIVE_AUDIO_RETENTION_HOURS=
# A FAILED recording's raw pieces (source/live-rec/…) are kept this long for
# investigation, then deleted. Ready recordings are VideoAssets and are kept.
# Default 72.
LIVE_RECORDING_FAILED_RETENTION_HOURS=

# ── Live classrooms (Daily — the fallback) ────────────────────────────────
# The API key is the platform's own and must stay on the server: it creates
# rooms and mints meeting tokens, so anything holding it can join any class.
# It is never sent to the browser — the frontend only ever receives a room URL
# and a short-lived token scoped to one participant in one room.
# Get both from https://dashboard.daily.co → Developers.
# Leaving DAILY_API_KEY empty disables the built-in classroom; sessions with a
# pasted Zoom/Meet link keep working exactly as before.
DAILY_API_KEY=
# Your Daily team domain, e.g. yourteam.daily.co
DAILY_DOMAIN=
# Transcription provider for live-class summaries. Set it and the API wires it
# to the Daily domain itself at the first class — and re-wires it after a
# rotation. Server-only; never in the browser, never pasted anywhere else.
DEEPGRAM_API_KEY=

# ── Video packaging worker ────────────────────────────────────────────────
# Video is transcoded by a durable Postgres-backed queue (VideoJob), not
# fire-and-forget: a crash or redeploy mid-ffmpeg no longer strands the asset,
# because the job's lease expires and another replica re-claims it.
# Set false on a replica that should not take video work. Off everywhere means
# uploads are queued and never packaged.
VIDEO_WORKER_ENABLED=true
# Deliberately 1, and deliberately NOT the AI worker's WORKER_CONCURRENCY=3:
# ffmpeg saturates a core on the same container that serves HTTP, so a second
# concurrent encode is felt as request latency by every user on that replica.
VIDEO_WORKER_CONCURRENCY=1
