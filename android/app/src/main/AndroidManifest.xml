<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Permissions — the minimum this app can do its job with.

      RECEIVE_SMS      : deliver incoming SMS to our BroadcastReceiver. This is the
                         ONLY SMS permission requested. READ_SMS is deliberately NOT
                         requested: we never read the user's SMS history, only
                         messages that arrive while the app is installed.
      INTERNET         : post events to the Darsly backend.
      POST_NOTIFICATIONS: (API 33+) notify that a payment SMS was detected.
      READ_PHONE_STATE : optional, dual-SIM only — resolve a subscription id to a
                         human SIM slot. The app works fully without it.
      RECEIVE_BOOT_COMPLETED: let WorkManager restore the pending-outbox sync job
                         after a reboot, so an SMS received before a restart is
                         still delivered.
    -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.hardware.telephony" android:required="true" />

    <application
        android:name=".DarslyListenerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DarslySmsListener"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Manifest-declared so it fires even when the app process is not running.
          SMS_RECEIVED is exempt from the implicit-broadcast restrictions of
          Android 8+, so this is the supported way to observe incoming SMS —
          no foreground service, no battery-optimization games.

          android:exported="true" is required: the broadcast comes from the system.
          The permission attribute restricts senders to the system's BROADCAST_SMS
          holder, so no third-party app can spoof an SMS into this receiver.
        -->
        <receiver
            android:name=".sms.SmsReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
