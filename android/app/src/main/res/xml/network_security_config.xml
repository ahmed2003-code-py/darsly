<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS-only. Cleartext is disabled app-wide; the debug overlay
  (src/debug/res/xml/network_security_config.xml) re-enables it for the local
  development backend only. Certificate validation uses the standard Android
  trust store — no custom TrustManager, no pinning that would silently break on
  rotation.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
